{
  "compilerOptions": {
    // 渲染进程只跑在 Electron 内置的 Chromium 156 里（同 package.json 钉死的
    // Electron 45.0.0），没有浏览器兼容矩阵，故 lib 取 ES2024。
    // 这里的 target 只影响类型检查：构建期降级由 Vite 负责，不读 tsconfig 的 target。
    // vite.config.ts 未设 build.target，Vite 8 用默认的 baseline-widely-available
    // （chrome111 / edge111 / firefox114 / safari16.4 / ios16.4），转译走 oxc + rolldown
    // （Vite 8 起取代 esbuild；transformWithEsbuild 已弃用）.
    "target": "ES2024",
    "useDefineForClassFields": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // typescript 7 起不再自动包含 node_modules/@types/*（5.x 会扫 node_modules/@types 下全部包），
    // 必须显式声明。本 config 的 include 含 adapter/ 与测试，其中用到 node:crypto、node:fs 等，
    // 故列 node；DOM 侧类型由上面的 lib 提供，不依赖 @types/*。
    // 原 baseUrl + "@shared/*" 别名已删：全仓库零引用（各处都用相对路径 ../shared/），
    // 而 TS7 移除了 baseUrl、paths 也要求相对路径写法，留着只会在升级时报错。
    "types": ["node"]
  },
  "include": ["src", "shared", "adapter"]
}
