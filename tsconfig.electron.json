{
  "compilerOptions": {
    // 运行时下限：主进程跑在 Electron 45.0.0 内置的 Node 24.22.0（V8 15.6），引擎
    // 子进程用的捆绑 Node 是 24.21.0——两者都由 package.json / node-runtime.mjs 钉死，
    // 没有用户环境矩阵；取两者中更低的 24.21 作下限，所以 target 与 lib 取 ES2024 是
    // 准确的而不是乐观的。
    // 注意 typescript 5.9 的 lib 只到 es2024（没有 es2025），ES2024 即上限。
    // 提 lib 的实际收益是标准库类型：ES2023 的 findLast/toSorted、ES2024 的
    // Object.groupBy / Promise.withResolvers / Array.fromAsync 现在都能写。
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["electron", "adapter", "shared"],
  "exclude": ["**/__tests__/**", "**/*.test.ts"]
}
