{
  "name": "dsh-desktop",
  "version": "1.0.31",
  "description": "Desktop Client for DeepSeek Harness",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "author": "Oissp <19642615+Oissp@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/Oissp/dsh-desktop",
  "private": true,
  "desktopName": "com.dsh.desktop.desktop",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "postinstall": "node scripts/ensure-electron.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "pnpm build && electron-builder --linux deb --x64"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9"
  }
}
